# Copy to .env.local (and add to Vercel) with real values.

# Resend: emails the team about each early-access sign-up.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated recipients.
EARLY_ACCESS_NOTIFY_EMAILS=

# Optional: also forward each sign-up as JSON (Google Sheets Apps Script, Zapier, Make…).
EARLY_ACCESS_WEBHOOK_URL=
